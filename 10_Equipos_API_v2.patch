diff --git a/08_Equipos_Procedimientos.sql b/08_Equipos_Procedimientos.sql
new file mode 100644
index 0000000..3fc053f
--- /dev/null
+++ b/08_Equipos_Procedimientos.sql
@@ -0,0 +1,258 @@
+﻿-- Actualización para una TechCare existente. Ejecutar completo en SSMS.
+-- Conserva las tablas y los registros; CREATE OR ALTER permite repetir el script.
+USE [TechCare];
+GO
+SET ANSI_NULLS ON;
+SET QUOTED_IDENTIFIER ON;
+GO
+
+-- Equipos: las consultas y escrituras se resuelven en SQL Server.
+CREATE OR ALTER PROCEDURE dbo.spListarEquipos
+    @ClienteID int = NULL, @Serie nvarchar(max) = NULL, @Activo bit = NULL
+AS
+BEGIN
+    SET NOCOUNT ON;
+    IF @ClienteID IS NOT NULL AND @ClienteID <= 0
+        THROW 51300, N'El cliente del filtro debe ser mayor que cero.', 1;
+    SET @Serie=NULLIF(LTRIM(RTRIM(@Serie)), N'');
+    IF DATALENGTH(@Serie)>160
+        THROW 51300, N'El filtro de serie admite hasta 80 caracteres.', 1;
+    SELECT e.EquipoID, e.ClienteID, c.Nombre AS Cliente, c.Activo AS ClienteActivo,
+           e.ModeloEquipoID, mo.Nombre AS Modelo, ma.MarcaID, ma.Nombre AS Marca,
+           t.TipoEquipoID, t.Nombre AS TipoEquipo, e.NumeroSerie, e.Descripcion, e.Activo,
+           CONVERT(bit, CASE WHEN EXISTS (SELECT 1 FROM dbo.OrdenServicio o WHERE o.EquipoID=e.EquipoID)
+                            THEN 1 ELSE 0 END) AS TieneOrdenes
+    FROM dbo.Equipo e
+    INNER JOIN dbo.Cliente c ON c.ClienteID=e.ClienteID
+    INNER JOIN dbo.ModeloEquipo mo ON mo.ModeloEquipoID=e.ModeloEquipoID
+    INNER JOIN dbo.Marca ma ON ma.MarcaID=mo.MarcaID
+    INNER JOIN dbo.TipoEquipo t ON t.TipoEquipoID=mo.TipoEquipoID
+    WHERE (@ClienteID IS NULL OR e.ClienteID=@ClienteID)
+      AND (@Serie IS NULL OR CHARINDEX(@Serie, e.NumeroSerie)>0)
+      AND (@Activo IS NULL OR e.Activo=@Activo)
+    ORDER BY e.EquipoID;
+END;
+GO
+
+CREATE OR ALTER PROCEDURE dbo.spConsultarEquipo
+    @EquipoID int
+AS
+BEGIN
+    SET NOCOUNT ON;
+    IF @EquipoID IS NULL OR @EquipoID<=0
+        THROW 51300, N'El ID debe ser mayor que cero.', 1;
+    IF NOT EXISTS (SELECT 1 FROM dbo.Equipo WHERE EquipoID=@EquipoID)
+        THROW 51302, N'El equipo no existe.', 1;
+    SELECT e.EquipoID, e.ClienteID, c.Nombre AS Cliente, c.Activo AS ClienteActivo,
+           e.ModeloEquipoID, mo.Nombre AS Modelo, ma.MarcaID, ma.Nombre AS Marca,
+           t.TipoEquipoID, t.Nombre AS TipoEquipo, e.NumeroSerie, e.Descripcion, e.Activo,
+           CONVERT(bit, CASE WHEN EXISTS (SELECT 1 FROM dbo.OrdenServicio o WHERE o.EquipoID=e.EquipoID)
+                            THEN 1 ELSE 0 END) AS TieneOrdenes
+    FROM dbo.Equipo e
+    INNER JOIN dbo.Cliente c ON c.ClienteID=e.ClienteID
+    INNER JOIN dbo.ModeloEquipo mo ON mo.ModeloEquipoID=e.ModeloEquipoID
+    INNER JOIN dbo.Marca ma ON ma.MarcaID=mo.MarcaID
+    INNER JOIN dbo.TipoEquipo t ON t.TipoEquipoID=mo.TipoEquipoID
+    WHERE e.EquipoID=@EquipoID;
+END;
+GO
+
+CREATE OR ALTER PROCEDURE dbo.spHistorialEquipo
+    @EquipoID int
+AS
+BEGIN
+    SET NOCOUNT ON;
+    IF @EquipoID IS NULL OR @EquipoID<=0
+        THROW 51300, N'El ID debe ser mayor que cero.', 1;
+    IF NOT EXISTS (SELECT 1 FROM dbo.Equipo WHERE EquipoID=@EquipoID)
+        THROW 51302, N'El equipo no existe.', 1;
+    -- La vista conserva equipos sin órdenes; el historial devuelve [] para ellos.
+    SELECT EquipoID, NumeroSerie, ClienteID, Cliente, OrdenID, NumeroOrden, FechaIngreso, EstadoCodigo,
+           FechaDiagnostico, Diagnostico, ReparacionID, FechaInicio, FechaFin, DescripcionTrabajo,
+           FacturaID, Total, Saldo, FechaEntrega
+    FROM dbo.vHistorialEquipo
+    WHERE EquipoID=@EquipoID AND OrdenID IS NOT NULL
+    ORDER BY FechaIngreso DESC, OrdenID DESC;
+END;
+GO
+
+CREATE OR ALTER PROCEDURE dbo.spRegistrarEquipo
+    @ClienteID int, @ModeloEquipoID int, @NumeroSerie nvarchar(max),
+    @Descripcion nvarchar(max), @Activo bit
+AS
+BEGIN
+    SET NOCOUNT ON;
+    SET XACT_ABORT ON;
+    DECLARE @Propia bit=CASE WHEN @@TRANCOUNT=0 THEN 1 ELSE 0 END;
+    DECLARE @Resultado TABLE (
+        EquipoID int, ClienteID int, ModeloEquipoID int, NumeroSerie varchar(80),
+        Descripcion nvarchar(500), Activo bit
+    );
+    BEGIN TRY
+        IF @Propia=1 BEGIN TRANSACTION;
+        ELSE SAVE TRANSACTION spRegistrarEquipo;
+        SET @NumeroSerie=NULLIF(LTRIM(RTRIM(@NumeroSerie)), N'');
+        SET @Descripcion=NULLIF(LTRIM(RTRIM(@Descripcion)), N'');
+        -- Parámetros amplios para rechazar textos largos antes de convertirlos a las columnas.
+        IF @NumeroSerie IS NULL OR DATALENGTH(CONVERT(varchar(max), @NumeroSerie))>80
+            THROW 51300, N'La serie es obligatoria y admite hasta 80 caracteres.', 1;
+        IF @Descripcion IS NULL OR DATALENGTH(@Descripcion)>1000
+            THROW 51300, N'La descripción es obligatoria y admite hasta 500 caracteres.', 1;
+        IF @Activo IS NULL
+            THROW 51300, N'Activo es obligatorio.', 1;
+        IF @ClienteID IS NULL OR NOT EXISTS (
+            SELECT 1 FROM dbo.Cliente WITH (HOLDLOCK) WHERE ClienteID=@ClienteID)
+            THROW 51301, N'El cliente no existe.', 1;
+        IF @Activo=1 AND EXISTS (
+            SELECT 1 FROM dbo.Cliente WHERE ClienteID=@ClienteID AND Activo=0)
+            THROW 51301, N'Un equipo activo requiere un cliente activo.', 1;
+        IF @ModeloEquipoID IS NULL OR NOT EXISTS (
+            SELECT 1 FROM dbo.ModeloEquipo WITH (HOLDLOCK) WHERE ModeloEquipoID=@ModeloEquipoID)
+            THROW 51301, N'El modelo de equipo no existe.', 1;
+        IF EXISTS (SELECT 1 FROM dbo.Equipo WHERE NumeroSerie=@NumeroSerie)
+            THROW 51303, N'La serie ya está registrada en otro equipo.', 1;
+        INSERT dbo.Equipo (ClienteID, ModeloEquipoID, NumeroSerie, Descripcion, Activo)
+        OUTPUT inserted.EquipoID, inserted.ClienteID, inserted.ModeloEquipoID,
+               inserted.NumeroSerie, inserted.Descripcion, inserted.Activo INTO @Resultado
+        VALUES (@ClienteID, @ModeloEquipoID, @NumeroSerie, @Descripcion, @Activo);
+        IF @Propia=1 COMMIT TRANSACTION;
+        -- La respuesta conserva los valores de esta escritura.
+    SELECT e.EquipoID, e.ClienteID, c.Nombre AS Cliente, c.Activo AS ClienteActivo,
+           e.ModeloEquipoID, mo.Nombre AS Modelo, ma.MarcaID, ma.Nombre AS Marca,
+           t.TipoEquipoID, t.Nombre AS TipoEquipo, e.NumeroSerie, e.Descripcion, e.Activo,
+           CONVERT(bit, CASE WHEN EXISTS (SELECT 1 FROM dbo.OrdenServicio o WHERE o.EquipoID=e.EquipoID)
+                            THEN 1 ELSE 0 END) AS TieneOrdenes
+    FROM @Resultado e
+    INNER JOIN dbo.Cliente c ON c.ClienteID=e.ClienteID
+    INNER JOIN dbo.ModeloEquipo mo ON mo.ModeloEquipoID=e.ModeloEquipoID
+    INNER JOIN dbo.Marca ma ON ma.MarcaID=mo.MarcaID
+    INNER JOIN dbo.TipoEquipo t ON t.TipoEquipoID=mo.TipoEquipoID;
+    END TRY
+    BEGIN CATCH
+        IF @Propia=1 AND XACT_STATE()<>0 ROLLBACK TRANSACTION;
+        ELSE IF @Propia=0 AND XACT_STATE()=1 ROLLBACK TRANSACTION spRegistrarEquipo;
+        IF ERROR_NUMBER() IN (2601,2627)
+            THROW 51303, N'La serie ya está registrada en otro equipo.', 1;
+        THROW;
+    END CATCH;
+END;
+GO
+
+CREATE OR ALTER PROCEDURE dbo.spActualizarEquipo
+    @EquipoID int,
+    @ClienteID int, @ModeloEquipoID int, @NumeroSerie nvarchar(max),
+    @Descripcion nvarchar(max), @Activo bit
+AS
+BEGIN
+    SET NOCOUNT ON;
+    SET XACT_ABORT ON;
+    DECLARE @Propia bit=CASE WHEN @@TRANCOUNT=0 THEN 1 ELSE 0 END;
+    DECLARE @Resultado TABLE (
+        EquipoID int, ClienteID int, ModeloEquipoID int, NumeroSerie varchar(80),
+        Descripcion nvarchar(500), Activo bit
+    );
+    BEGIN TRY
+        IF @Propia=1 BEGIN TRANSACTION;
+        ELSE SAVE TRANSACTION spActualizarEquipo;
+        IF @EquipoID IS NULL OR @EquipoID<=0
+            THROW 51300, N'El ID debe ser mayor que cero.', 1;
+        IF NOT EXISTS (SELECT 1 FROM dbo.Equipo WITH (UPDLOCK, HOLDLOCK) WHERE EquipoID=@EquipoID)
+            THROW 51302, N'El equipo no existe.', 1;
+        SET @NumeroSerie=NULLIF(LTRIM(RTRIM(@NumeroSerie)), N'');
+        SET @Descripcion=NULLIF(LTRIM(RTRIM(@Descripcion)), N'');
+        -- Parámetros amplios para rechazar textos largos antes de convertirlos a las columnas.
+        IF @NumeroSerie IS NULL OR DATALENGTH(CONVERT(varchar(max), @NumeroSerie))>80
+            THROW 51300, N'La serie es obligatoria y admite hasta 80 caracteres.', 1;
+        IF @Descripcion IS NULL OR DATALENGTH(@Descripcion)>1000
+            THROW 51300, N'La descripción es obligatoria y admite hasta 500 caracteres.', 1;
+        IF @Activo IS NULL
+            THROW 51300, N'Activo es obligatorio.', 1;
+        IF @ClienteID IS NULL OR NOT EXISTS (
+            SELECT 1 FROM dbo.Cliente WITH (HOLDLOCK) WHERE ClienteID=@ClienteID)
+            THROW 51301, N'El cliente no existe.', 1;
+        IF @Activo=1 AND EXISTS (
+            SELECT 1 FROM dbo.Cliente WHERE ClienteID=@ClienteID AND Activo=0)
+            THROW 51301, N'Un equipo activo requiere un cliente activo.', 1;
+        IF @ModeloEquipoID IS NULL OR NOT EXISTS (
+            SELECT 1 FROM dbo.ModeloEquipo WITH (HOLDLOCK) WHERE ModeloEquipoID=@ModeloEquipoID)
+            THROW 51301, N'El modelo de equipo no existe.', 1;
+        IF EXISTS (SELECT 1 FROM dbo.OrdenServicio WITH (HOLDLOCK) WHERE EquipoID=@EquipoID)
+           AND EXISTS (SELECT 1 FROM dbo.Equipo WHERE EquipoID=@EquipoID AND
+               (ClienteID<>@ClienteID OR ModeloEquipoID<>@ModeloEquipoID OR NumeroSerie<>@NumeroSerie))
+            THROW 51304, N'Equipo con historial: propietario, serie y modelo no se cambian.', 1;
+        IF EXISTS (SELECT 1 FROM dbo.Equipo WHERE NumeroSerie=@NumeroSerie AND EquipoID<>@EquipoID)
+            THROW 51303, N'La serie ya está registrada en otro equipo.', 1;
+        UPDATE dbo.Equipo
+        SET ClienteID=@ClienteID, ModeloEquipoID=@ModeloEquipoID, NumeroSerie=@NumeroSerie,
+            Descripcion=@Descripcion, Activo=@Activo
+        OUTPUT inserted.EquipoID, inserted.ClienteID, inserted.ModeloEquipoID,
+               inserted.NumeroSerie, inserted.Descripcion, inserted.Activo INTO @Resultado
+        WHERE EquipoID=@EquipoID;
+        IF @Propia=1 COMMIT TRANSACTION;
+        -- La respuesta conserva los valores de esta escritura.
+    SELECT e.EquipoID, e.ClienteID, c.Nombre AS Cliente, c.Activo AS ClienteActivo,
+           e.ModeloEquipoID, mo.Nombre AS Modelo, ma.MarcaID, ma.Nombre AS Marca,
+           t.TipoEquipoID, t.Nombre AS TipoEquipo, e.NumeroSerie, e.Descripcion, e.Activo,
+           CONVERT(bit, CASE WHEN EXISTS (SELECT 1 FROM dbo.OrdenServicio o WHERE o.EquipoID=e.EquipoID)
+                            THEN 1 ELSE 0 END) AS TieneOrdenes
+    FROM @Resultado e
+    INNER JOIN dbo.Cliente c ON c.ClienteID=e.ClienteID
+    INNER JOIN dbo.ModeloEquipo mo ON mo.ModeloEquipoID=e.ModeloEquipoID
+    INNER JOIN dbo.Marca ma ON ma.MarcaID=mo.MarcaID
+    INNER JOIN dbo.TipoEquipo t ON t.TipoEquipoID=mo.TipoEquipoID;
+    END TRY
+    BEGIN CATCH
+        IF @Propia=1 AND XACT_STATE()<>0 ROLLBACK TRANSACTION;
+        ELSE IF @Propia=0 AND XACT_STATE()=1 ROLLBACK TRANSACTION spActualizarEquipo;
+        IF ERROR_NUMBER() IN (2601,2627)
+            THROW 51303, N'La serie ya está registrada en otro equipo.', 1;
+        THROW;
+    END CATCH;
+END;
+GO
+
+CREATE OR ALTER PROCEDURE dbo.spListarTiposEquipo
+AS
+BEGIN
+    SET NOCOUNT ON;
+    SELECT TipoEquipoID, Nombre FROM dbo.TipoEquipo ORDER BY Nombre, TipoEquipoID;
+END;
+GO
+
+CREATE OR ALTER PROCEDURE dbo.spListarMarcas
+AS
+BEGIN
+    SET NOCOUNT ON;
+    SELECT MarcaID, Nombre FROM dbo.Marca ORDER BY Nombre, MarcaID;
+END;
+GO
+
+CREATE OR ALTER PROCEDURE dbo.spListarModelosEquipo
+    @MarcaID int = NULL, @TipoEquipoID int = NULL
+AS
+BEGIN
+    SET NOCOUNT ON;
+    IF (@MarcaID IS NOT NULL AND @MarcaID<=0) OR (@TipoEquipoID IS NOT NULL AND @TipoEquipoID<=0)
+        THROW 51300, N'Los filtros de marca y tipo deben ser mayores que cero.', 1;
+    SELECT mo.ModeloEquipoID, mo.Nombre, mo.MarcaID, ma.Nombre AS Marca,
+           mo.TipoEquipoID, t.Nombre AS TipoEquipo
+    FROM dbo.ModeloEquipo mo
+    INNER JOIN dbo.Marca ma ON ma.MarcaID=mo.MarcaID
+    INNER JOIN dbo.TipoEquipo t ON t.TipoEquipoID=mo.TipoEquipoID
+    WHERE (@MarcaID IS NULL OR mo.MarcaID=@MarcaID)
+      AND (@TipoEquipoID IS NULL OR mo.TipoEquipoID=@TipoEquipoID)
+    ORDER BY ma.Nombre, mo.Nombre, mo.ModeloEquipoID;
+END;
+GO
+
+-- Equipos se mantiene exclusivamente mediante sus procedimientos.
+DENY INSERT, UPDATE, DELETE ON OBJECT::dbo.Equipo TO techcare_app;
+GRANT EXECUTE ON OBJECT::dbo.spListarEquipos TO techcare_app;
+GRANT EXECUTE ON OBJECT::dbo.spConsultarEquipo TO techcare_app;
+GRANT EXECUTE ON OBJECT::dbo.spHistorialEquipo TO techcare_app;
+GRANT EXECUTE ON OBJECT::dbo.spRegistrarEquipo TO techcare_app;
+GRANT EXECUTE ON OBJECT::dbo.spActualizarEquipo TO techcare_app;
+GRANT EXECUTE ON OBJECT::dbo.spListarTiposEquipo TO techcare_app;
+GRANT EXECUTE ON OBJECT::dbo.spListarMarcas TO techcare_app;
+GRANT EXECUTE ON OBJECT::dbo.spListarModelosEquipo TO techcare_app;
+GO
diff --git a/09_Pruebas_Equipos.sql b/09_Pruebas_Equipos.sql
new file mode 100644
index 0000000..4ab906b
--- /dev/null
+++ b/09_Pruebas_Equipos.sql
@@ -0,0 +1,135 @@
+﻿-- Ejecutar completo en SSMS después del 08, usando una cuenta de pruebas con permisos de administración.
+-- Cada caso se revierte. Los únicos registros temporales persistidos son dos clientes y dos equipos;
+-- se eliminan al terminar. No se cambia ninguna orden, cliente ni equipo preexistente.
+-- Requiere los catálogos y un usuario de RECEPCION del conjunto de demostración.
+USE [TechCare];
+GO
+SET NOCOUNT ON;
+SET XACT_ABORT ON;
+IF @@TRANCOUNT<>0 THROW 51981,N'Ejecutá las pruebas sin una transacción previa abierta.',1;
+DECLARE @Token varchar(20)=LEFT(REPLACE(CONVERT(varchar(36),NEWID()),'-',''),20);
+DECLARE @Cliente1 int,@Cliente2 int,@Equipo1 int,@Equipo2 int,
+ @Modelo1 int=(SELECT MIN(ModeloEquipoID) FROM dbo.ModeloEquipo),@Modelo2 int,
+ @Recepcion int=(SELECT MIN(UsuarioID) FROM dbo.Usuario WHERE Activo=1 AND dbo.fnTieneRol(UsuarioID,'RECEPCION')=1),
+ @TipoCliente tinyint=(SELECT MIN(TipoClienteID) FROM dbo.TipoCliente),@Marca int,@Tipo int;
+SET @Modelo2=(SELECT MIN(ModeloEquipoID) FROM dbo.ModeloEquipo WHERE ModeloEquipoID<>@Modelo1);
+IF @Modelo1 IS NULL OR @Modelo2 IS NULL OR @Recepcion IS NULL OR @TipoCliente IS NULL
+ THROW 51982,N'Faltan catálogos, dos modelos o un usuario de RECEPCION para las pruebas.',1;
+SELECT @Marca=MarcaID,@Tipo=TipoEquipoID FROM dbo.ModeloEquipo WHERE ModeloEquipoID=@Modelo1;
+DECLARE @Serie1 nvarchar(80)=N'TEST-EQ-A-'+@Token,@Serie2 nvarchar(80)=N'TEST-EQ-B-'+@Token,
+ @NuevaSerie nvarchar(80)=N'TEST-EQ-C-'+@Token,@NumeroOrden varchar(30)='TEST-EQ-'+@Token,
+ @NIT1 varchar(20)='EQA'+LEFT(@Token,17),@NIT2 varchar(20)='EQB'+LEFT(@Token,17);
+BEGIN TRY
+ BEGIN TRANSACTION;
+ INSERT dbo.Cliente(TipoClienteID,NIT,Nombre,Activo) VALUES(@TipoCliente,@NIT1,N'PRUEBA temporal Equipos A',1);
+ SET @Cliente1=CONVERT(int,SCOPE_IDENTITY());
+ INSERT dbo.Cliente(TipoClienteID,NIT,Nombre,Activo) VALUES(@TipoCliente,@NIT2,N'PRUEBA temporal Equipos B',0);
+ SET @Cliente2=CONVERT(int,SCOPE_IDENTITY());
+ INSERT dbo.Equipo(ClienteID,ModeloEquipoID,NumeroSerie,Descripcion,Activo)
+ VALUES(@Cliente1,@Modelo1,@Serie1,N'PRUEBA temporal Equipos A',1);
+ SET @Equipo1=CONVERT(int,SCOPE_IDENTITY());
+ INSERT dbo.Equipo(ClienteID,ModeloEquipoID,NumeroSerie,Descripcion,Activo)
+ VALUES(@Cliente1,@Modelo1,@Serie2,N'PRUEBA temporal Equipos B',1);
+ SET @Equipo2=CONVERT(int,SCOPE_IDENTITY());
+ COMMIT TRANSACTION;
+END TRY
+BEGIN CATCH
+ IF XACT_STATE()<>0 ROLLBACK TRANSACTION;
+ THROW;
+END CATCH;
+DECLARE @Casos TABLE(ID int IDENTITY(1,1),Caso nvarchar(200),Sentencia nvarchar(max),ErrorEsperado int);
+INSERT @Casos(Caso,Sentencia,ErrorEsperado) VALUES
+(N'Registrar devuelve ID y conserva Unicode',N'DECLARE @R TABLE (EquipoID int, ClienteID int, Cliente nvarchar(150), ClienteActivo bit,
+ModeloEquipoID int, Modelo nvarchar(80), MarcaID int, Marca nvarchar(60), TipoEquipoID tinyint,
+TipoEquipo nvarchar(50), NumeroSerie varchar(80), Descripcion nvarchar(500), Activo bit, TieneOrdenes bit);
+INSERT @R EXEC dbo.spRegistrarEquipo @Cliente1, @Modelo1, @NuevaSerie, N''Revisión ñ 漢字'', 1;
+IF NOT EXISTS(SELECT 1 FROM @R WHERE EquipoID>0 AND Descripcion=N''Revisión ñ 漢字'' AND TieneOrdenes=0) THROW 51980,N''Respuesta de registro incorrecta.'',1;',0),
+(N'Actualizar conserva la misma serie',N'DECLARE @R TABLE (EquipoID int, ClienteID int, Cliente nvarchar(150), ClienteActivo bit,
+ModeloEquipoID int, Modelo nvarchar(80), MarcaID int, Marca nvarchar(60), TipoEquipoID tinyint,
+TipoEquipo nvarchar(50), NumeroSerie varchar(80), Descripcion nvarchar(500), Activo bit, TieneOrdenes bit);
+INSERT @R EXEC dbo.spActualizarEquipo @Equipo1, @Cliente1, @Modelo1, @Serie1, N''Descripción modificada'', 1;
+IF NOT EXISTS(SELECT 1 FROM @R WHERE EquipoID=@Equipo1 AND NumeroSerie=@Serie1 AND Descripcion=N''Descripción modificada'') THROW 51980,N''Actualización incorrecta.'',1;',0),
+(N'Desactivar conserva el registro',N'EXEC dbo.spActualizarEquipo @Equipo1,@Cliente1,@Modelo1,@Serie1,N''Equipo inactivo'',0; IF NOT EXISTS(SELECT 1 FROM dbo.Equipo WHERE EquipoID=@Equipo1 AND Activo=0) THROW 51980,N''No conservó el registro.'',1;',0),
+(N'Serie duplicada al crear',N'EXEC dbo.spRegistrarEquipo @Cliente1,@Modelo1,@Serie1,N''Duplicado'',1;',51303),
+(N'Serie de otro equipo al actualizar',N'EXEC dbo.spActualizarEquipo @Equipo1,@Cliente1,@Modelo1,@Serie2,N''Duplicado'',1;',51303),
+(N'Cliente inexistente',N'EXEC dbo.spRegistrarEquipo -1,@Modelo1,@NuevaSerie,N''Cliente inválido'',1;',51301),
+(N'Modelo inexistente',N'EXEC dbo.spRegistrarEquipo @Cliente1,-1,@NuevaSerie,N''Modelo inválido'',1;',51301),
+(N'Equipo activo requiere cliente activo',N'EXEC dbo.spRegistrarEquipo @Cliente2,@Modelo1,@NuevaSerie,N''Cliente inactivo'',1;',51301),
+(N'Serie obligatoria en la BD',N'EXEC dbo.spRegistrarEquipo @Cliente1,@Modelo1,N''   '',N''Prueba'',1;',51300),
+(N'Descripción obligatoria en la BD',N'EXEC dbo.spRegistrarEquipo @Cliente1,@Modelo1,@NuevaSerie,N''   '',1;',51300),
+(N'Serie larga rechazada sin truncar',N'DECLARE @Texto nvarchar(max)=REPLICATE(N''X'',81); EXEC dbo.spRegistrarEquipo @Cliente1,@Modelo1,@Texto,N''Prueba'',1;',51300),
+(N'Descripción larga rechazada sin truncar',N'DECLARE @Texto nvarchar(max)=REPLICATE(N''X'',501); EXEC dbo.spRegistrarEquipo @Cliente1,@Modelo1,@NuevaSerie,@Texto,1;',51300),
+(N'Activo obligatorio en la BD',N'EXEC dbo.spRegistrarEquipo @Cliente1,@Modelo1,@NuevaSerie,N''Prueba'',NULL;',51300),
+(N'Consultar equipo inexistente',N'EXEC dbo.spConsultarEquipo 2147483647;',51302),
+(N'Consultar ID no positivo',N'EXEC dbo.spConsultarEquipo 0;',51300),
+(N'Actualizar equipo inexistente',N'EXEC dbo.spActualizarEquipo 2147483647,@Cliente1,@Modelo1,@NuevaSerie,N''Prueba'',1;',51302),
+(N'Filtro de cliente y serie',N'DECLARE @R TABLE (EquipoID int, ClienteID int, Cliente nvarchar(150), ClienteActivo bit,
+ModeloEquipoID int, Modelo nvarchar(80), MarcaID int, Marca nvarchar(60), TipoEquipoID tinyint,
+TipoEquipo nvarchar(50), NumeroSerie varchar(80), Descripcion nvarchar(500), Activo bit, TieneOrdenes bit);
+INSERT @R EXEC dbo.spListarEquipos @ClienteID=@Cliente1,@Serie=@Serie1,@Activo=1; IF (SELECT COUNT(*) FROM @R)<>1 OR NOT EXISTS(SELECT 1 FROM @R WHERE EquipoID=@Equipo1) THROW 51980,N''Filtro incorrecto.'',1;',0),
+(N'Serie con comodines se busca como texto literal',N'DECLARE @R TABLE (EquipoID int, ClienteID int, Cliente nvarchar(150), ClienteActivo bit,
+ModeloEquipoID int, Modelo nvarchar(80), MarcaID int, Marca nvarchar(60), TipoEquipoID tinyint,
+TipoEquipo nvarchar(50), NumeroSerie varchar(80), Descripcion nvarchar(500), Activo bit, TieneOrdenes bit);
+INSERT @R EXEC dbo.spListarEquipos @ClienteID=@Cliente1,@Serie=N''%_'',@Activo=NULL; IF EXISTS(SELECT 1 FROM @R) THROW 51980,N''Interpretó comodines como patrón.'',1;',0),
+(N'Historial sin órdenes devuelve cero filas',N'DECLARE @H TABLE(EquipoID int, NumeroSerie varchar(80), ClienteID int, Cliente nvarchar(150), OrdenID int, NumeroOrden varchar(30), FechaIngreso datetime2, EstadoCodigo varchar(30), FechaDiagnostico datetime2, Diagnostico nvarchar(2000), ReparacionID int, FechaInicio datetime2, FechaFin datetime2, DescripcionTrabajo nvarchar(2000), FacturaID int, Total decimal(18,2), Saldo decimal(18,2), FechaEntrega datetime2); INSERT @H EXEC dbo.spHistorialEquipo @Equipo1; IF EXISTS(SELECT 1 FROM @H) THROW 51980,N''Historial vacío incorrecto.'',1;',0),
+(N'Historial de equipo inexistente',N'EXEC dbo.spHistorialEquipo 2147483647;',51302),
+(N'Equipo con orden indica historial',N'DECLARE @Orden int; EXEC dbo.spCrearOrden @NumeroOrden=@NumeroOrden, @EquipoID=@Equipo1, @UsuarioID=@Recepcion, @Problema=N''Prueba reversible'', @OrdenID=@Orden OUTPUT;
+DECLARE @R TABLE (EquipoID int, ClienteID int, Cliente nvarchar(150), ClienteActivo bit,
+ModeloEquipoID int, Modelo nvarchar(80), MarcaID int, Marca nvarchar(60), TipoEquipoID tinyint,
