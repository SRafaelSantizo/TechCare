# URL base de la API TechCare (Spring Boot).
# En desarrollo puede dejarse relativo (/api) y usar el proxy de Vite
# configurado en vite.config.ts apuntando a VITE_PROXY_TARGET.
# En produccion usar la URL completa del backend, por ejemplo:
# VITE_API_BASE_URL=https://techcare.example.com/api
VITE_API_BASE_URL=/api

# Destino del proxy del servidor de desarrollo de Vite.
# Debe coincidir con server.port del backend (application.properties: 8080).
VITE_PROXY_TARGET=http://localhost:8080
