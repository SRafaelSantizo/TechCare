diff --git a/13_Usuarios_Procedimientos.sql b/13_Usuarios_Procedimientos.sql
new file mode 100644
index 0000000..5aaead0
--- /dev/null
+++ b/13_Usuarios_Procedimientos.sql
@@ -0,0 +1,186 @@
+-- Ejecutar una vez sobre la base TechCare existente. Puede repetirse.
+-- Agrega el alta de cuentas para ADMIN; conserva las tablas y los datos actuales.
+USE [TechCare];
+GO
+SET ANSI_NULLS ON;
+SET QUOTED_IDENTIFIER ON;
+GO
+
+CREATE OR ALTER PROCEDURE dbo.spListarUsuarios
+    @UsuarioActorID int,
+    @UsuarioID int = NULL
+AS
+BEGIN
+    SET NOCOUNT ON;
+    IF ISNULL(dbo.fnTieneRol(@UsuarioActorID, 'ADMIN'), 0) <> 1
+        THROW 51504, N'La operación requiere un administrador activo.', 1;
+    IF @UsuarioID IS NOT NULL AND @UsuarioID <= 0
+        THROW 51500, N'El identificador de usuario debe ser positivo.', 1;
+    IF @UsuarioID IS NOT NULL AND NOT EXISTS (SELECT 1 FROM dbo.Usuario WHERE UsuarioID = @UsuarioID)
+        THROW 51502, N'El usuario no existe.', 1;
+
+    SELECT u.UsuarioID, u.EmpleadoID, e.Codigo AS EmpleadoCodigo,
+           e.Nombres, e.Apellidos, u.NombreUsuario,
+           u.Activo AS UsuarioActivo, e.Activo AS EmpleadoActivo, u.FechaCreacion,
+           ISNULL((SELECT STRING_AGG(CONVERT(varchar(max), ur.RolCodigo), ',')
+                          WITHIN GROUP (ORDER BY ur.RolCodigo)
+                   FROM dbo.UsuarioRol ur WHERE ur.UsuarioID = u.UsuarioID), '') AS Roles
+    FROM dbo.Usuario u
+    INNER JOIN dbo.Empleado e ON e.EmpleadoID = u.EmpleadoID
+    WHERE @UsuarioID IS NULL OR u.UsuarioID = @UsuarioID
+    ORDER BY u.NombreUsuario, u.UsuarioID;
+END;
+GO
+
+CREATE OR ALTER PROCEDURE dbo.spListarRolesAcceso
+    @UsuarioActorID int
+AS
+BEGIN
+    SET NOCOUNT ON;
+    IF ISNULL(dbo.fnTieneRol(@UsuarioActorID, 'ADMIN'), 0) <> 1
+        THROW 51504, N'La operación requiere un administrador activo.', 1;
+    SELECT Codigo, Nombre FROM dbo.Rol ORDER BY Nombre;
+END;
+GO
+
+CREATE OR ALTER PROCEDURE dbo.spListarEmpleadosDisponibles
+    @UsuarioActorID int
+AS
+BEGIN
+    SET NOCOUNT ON;
+    IF ISNULL(dbo.fnTieneRol(@UsuarioActorID, 'ADMIN'), 0) <> 1
+        THROW 51504, N'La operación requiere un administrador activo.', 1;
+    SELECT e.EmpleadoID, e.Codigo, e.Nombres, e.Apellidos
+    FROM dbo.Empleado e
+    WHERE e.Activo = 1
+      AND NOT EXISTS (SELECT 1 FROM dbo.Usuario u WHERE u.EmpleadoID = e.EmpleadoID)
+    ORDER BY e.Nombres, e.Apellidos, e.Codigo;
+END;
+GO
+
+CREATE OR ALTER PROCEDURE dbo.spRegistrarUsuario
+    @UsuarioActorID int,
+    @EmpleadoID int,
+    @CodigoEmpleado nvarchar(max),
+    @Nombres nvarchar(max),
+    @Apellidos nvarchar(max),
+    @NombreUsuario nvarchar(max),
+    @PasswordHash nvarchar(max),
+    @Roles nvarchar(max)
+AS
+BEGIN
+    SET NOCOUNT ON;
+    SET XACT_ABORT ON;
+
+    SET @NombreUsuario = NULLIF(LTRIM(RTRIM(@NombreUsuario)), N'');
+    SET @CodigoEmpleado = NULLIF(LTRIM(RTRIM(@CodigoEmpleado)), N'');
+    SET @Nombres = NULLIF(LTRIM(RTRIM(@Nombres)), N'');
+    SET @Apellidos = NULLIF(LTRIM(RTRIM(@Apellidos)), N'');
+
+    IF ISNULL(dbo.fnTieneRol(@UsuarioActorID, 'ADMIN'), 0) <> 1
+        THROW 51504, N'La operación requiere un administrador activo.', 1;
+    IF @NombreUsuario IS NULL OR LEN(@NombreUsuario) NOT BETWEEN 3 AND 50
+       OR @NombreUsuario COLLATE Latin1_General_100_BIN2 LIKE N'%[^A-Za-z0-9._-]%'
+        THROW 51500, N'El usuario admite de 3 a 50 letras sin tildes, números, puntos, guiones o guiones bajos.', 1;
+    IF @EmpleadoID IS NULL AND
+       (@CodigoEmpleado IS NULL OR LEN(@CodigoEmpleado) > 20
+        OR @CodigoEmpleado COLLATE Latin1_General_100_BIN2 LIKE N'%[^A-Za-z0-9._-]%'
+        OR @Nombres IS NULL OR DATALENGTH(@Nombres) > 160
+        OR @Apellidos IS NULL OR DATALENGTH(@Apellidos) > 160)
+        THROW 51500, N'Completá código, nombres y apellidos del empleado dentro de sus límites.', 1;
+    IF @EmpleadoID IS NOT NULL AND
+       (@EmpleadoID <= 0 OR @CodigoEmpleado IS NOT NULL OR @Nombres IS NOT NULL OR @Apellidos IS NOT NULL)
+        THROW 51500, N'Elegí un empleado existente o ingresá uno nuevo, usando una sola opción.', 1;
+
+    -- Java genera este hash con una sal aleatoria. SQL nunca recibe la contraseña.
+    IF @PasswordHash IS NULL OR DATALENGTH(@PasswordHash) <> 182
+       OR LEFT(@PasswordHash, 22) COLLATE Latin1_General_100_BIN2 <> N'$pbkdf2-sha256$600000$'
+       OR SUBSTRING(@PasswordHash, 45, 3) <> N'==$'
+       OR RIGHT(@PasswordHash, 1) <> N'='
+       OR SUBSTRING(@PasswordHash, 23, 22) COLLATE Latin1_General_100_BIN2 LIKE N'%[^A-Za-z0-9+/]%'
+       OR SUBSTRING(@PasswordHash, 48, 43) COLLATE Latin1_General_100_BIN2 LIKE N'%[^A-Za-z0-9+/]%'
+        THROW 51500, N'El formato del hash de contraseña no es válido.', 1;
+
+    IF @Roles IS NULL OR DATALENGTH(@Roles) > 208
+        THROW 51500, N'Seleccioná entre uno y cinco roles válidos.', 1;
+    IF EXISTS (SELECT 1 FROM STRING_SPLIT(@Roles, N',')
+               WHERE LEN(value) NOT BETWEEN 1 AND 20
+                  OR value COLLATE Latin1_General_100_BIN2 LIKE N'%[^A-Z0-9_]%')
+       OR EXISTS (SELECT value FROM STRING_SPLIT(@Roles, N',') GROUP BY value HAVING COUNT(*) > 1)
+        THROW 51500, N'Los roles deben ser válidos y no pueden repetirse.', 1;
+
+    DECLARE @RolesElegidos TABLE (Codigo varchar(20) NOT NULL PRIMARY KEY);
+    INSERT INTO @RolesElegidos (Codigo) SELECT CONVERT(varchar(20), value) FROM STRING_SPLIT(@Roles, N',');
+    IF (SELECT COUNT(*) FROM @RolesElegidos) NOT BETWEEN 1 AND 5
+        THROW 51500, N'Seleccioná entre uno y cinco roles.', 1;
+
+    DECLARE @TransaccionPropia bit = CASE WHEN @@TRANCOUNT = 0 THEN 1 ELSE 0 END;
+    DECLARE @UsuarioNuevoID int;
+    DECLARE @Resultado TABLE (
+        UsuarioID int, EmpleadoID int, EmpleadoCodigo varchar(20),
+        Nombres nvarchar(80), Apellidos nvarchar(80), NombreUsuario varchar(50),
+        UsuarioActivo bit, EmpleadoActivo bit, FechaCreacion datetime2(0), Roles varchar(max)
+    );
+
+    BEGIN TRY
+        IF @TransaccionPropia = 1 BEGIN TRANSACTION;
+        ELSE SAVE TRANSACTION AltaUsuario;
+
+        IF EXISTS (SELECT 1 FROM @RolesElegidos r
+                   WHERE NOT EXISTS (SELECT 1 FROM dbo.Rol c WHERE c.Codigo = r.Codigo))
+            THROW 51501, N'Uno de los roles seleccionados no existe.', 1;
+
+        IF EXISTS (SELECT 1 FROM dbo.Usuario WITH (UPDLOCK, HOLDLOCK)
+                   WHERE NombreUsuario = CONVERT(varchar(50), @NombreUsuario))
+            THROW 51503, N'El nombre de usuario ya está registrado.', 1;
+
+        IF @EmpleadoID IS NULL
+        BEGIN
+            IF EXISTS (SELECT 1 FROM dbo.Empleado WITH (UPDLOCK, HOLDLOCK)
+                       WHERE Codigo = CONVERT(varchar(20), @CodigoEmpleado))
+                THROW 51503, N'El código del empleado ya existe. Seleccioná el empleado existente si aún no tiene cuenta.', 1;
+            INSERT INTO dbo.Empleado (Codigo, Nombres, Apellidos, Activo)
+            VALUES (CONVERT(varchar(20), @CodigoEmpleado), @Nombres, @Apellidos, 1);
+            SET @EmpleadoID = CONVERT(int, SCOPE_IDENTITY());
+        END
+        ELSE
+        BEGIN
+            IF NOT EXISTS (SELECT 1 FROM dbo.Empleado WITH (UPDLOCK, HOLDLOCK)
+                           WHERE EmpleadoID = @EmpleadoID AND Activo = 1)
+                THROW 51501, N'El empleado no existe o está inactivo.', 1;
+            IF EXISTS (SELECT 1 FROM dbo.Usuario WITH (UPDLOCK, HOLDLOCK) WHERE EmpleadoID = @EmpleadoID)
+                THROW 51503, N'El empleado ya tiene una cuenta de usuario.', 1;
+        END;
+
+        INSERT INTO dbo.Usuario (EmpleadoID, NombreUsuario, PasswordHash, AlgoritmoHash, Activo)
+        VALUES (@EmpleadoID, CONVERT(varchar(50), @NombreUsuario),
+                CONVERT(varchar(255), @PasswordHash), 'PBKDF2_SHA256', 1);
+        SET @UsuarioNuevoID = CONVERT(int, SCOPE_IDENTITY());
+        INSERT INTO dbo.UsuarioRol (UsuarioID, RolCodigo)
+        SELECT @UsuarioNuevoID, Codigo FROM @RolesElegidos;
+
+        INSERT INTO @Resultado
+        SELECT u.UsuarioID, u.EmpleadoID, e.Codigo, e.Nombres, e.Apellidos,
+               u.NombreUsuario, u.Activo, e.Activo, u.FechaCreacion,
+               (SELECT STRING_AGG(CONVERT(varchar(max), r.Codigo), ',')
+                       WITHIN GROUP (ORDER BY r.Codigo) FROM @RolesElegidos r)
+        FROM dbo.Usuario u INNER JOIN dbo.Empleado e ON e.EmpleadoID = u.EmpleadoID
+        WHERE u.UsuarioID = @UsuarioNuevoID;
+
+        IF @TransaccionPropia = 1 COMMIT TRANSACTION;
+        SELECT * FROM @Resultado;
+    END TRY
+    BEGIN CATCH
+        IF XACT_STATE() <> 0 AND @TransaccionPropia = 1 ROLLBACK TRANSACTION;
+        ELSE IF XACT_STATE() = 1 ROLLBACK TRANSACTION AltaUsuario;
+        IF ERROR_NUMBER() IN (2601, 2627)
+            THROW 51503, N'El usuario, el código del empleado o su cuenta ya están registrados.', 1;
+        THROW;
+    END CATCH;
+END;
+GO
+GRANT EXECUTE ON OBJECT::dbo.spListarUsuarios TO techcare_app;
+GRANT EXECUTE ON OBJECT::dbo.spListarRolesAcceso TO techcare_app;
+GRANT EXECUTE ON OBJECT::dbo.spListarEmpleadosDisponibles TO techcare_app;
+GRANT EXECUTE ON OBJECT::dbo.spRegistrarUsuario TO techcare_app;
+GO
diff --git a/14_Pruebas_Usuarios.sql b/14_Pruebas_Usuarios.sql
new file mode 100644
index 0000000..fe686d3
--- /dev/null
+++ b/14_Pruebas_Usuarios.sql
@@ -0,0 +1,126 @@
+-- Pruebas opcionales del alta de usuarios. Ejecutar después del script 13.
+-- Cada caso revierte sus empleados, cuentas y roles de prueba.
+USE [TechCare];
+GO
+SET NOCOUNT ON;
+SET XACT_ABORT ON;
+IF @@TRANCOUNT <> 0 THROW 51990, N'Ejecutá estas pruebas sin una transacción abierta.', 1;
+IF OBJECT_ID(N'dbo.spRegistrarUsuario', N'P') IS NULL
+    THROW 51990, N'Ejecutá primero 13_Usuarios_Procedimientos.sql.', 1;
+
+DECLARE @Admin int = (SELECT TOP (1) UsuarioID FROM dbo.Usuario
+                     WHERE dbo.fnTieneRol(UsuarioID, 'ADMIN') = 1 ORDER BY UsuarioID);
+IF @Admin IS NULL OR NOT EXISTS (SELECT 1 FROM dbo.Rol WHERE Codigo = 'TECNICO')
+                  OR NOT EXISTS (SELECT 1 FROM dbo.Rol WHERE Codigo = 'CAJA')
+    THROW 51990, N'Las pruebas requieren un ADMIN activo y los roles TECNICO y CAJA.', 1;
+
+DECLARE @UsuariosIniciales bigint = (SELECT COUNT_BIG(*) FROM dbo.Usuario);
+DECLARE @EmpleadosIniciales bigint = (SELECT COUNT_BIG(*) FROM dbo.Empleado);
+DECLARE @RolesIniciales bigint = (SELECT COUNT_BIG(*) FROM dbo.UsuarioRol);
+DECLARE @Casos TABLE (ID int PRIMARY KEY, Caso nvarchar(180), ErrorEsperado int);
+INSERT INTO @Casos VALUES
+(1, N'Crear empleado y cuenta con Unicode y varios roles', 0),
+(2, N'Crear cuenta para un empleado existente sin duplicarlo', 0),
+(3, N'Rechazar actor sin rol ADMIN', 51504),
+(4, N'Rechazar nombre de usuario duplicado', 51503),
+(5, N'Rechazar código de empleado duplicado', 51503),
+(6, N'Rechazar empleado inactivo', 51501),
+(7, N'Rechazar segunda cuenta para el mismo empleado', 51503),
+(8, N'Rechazar rol inexistente', 51501),
+(9, N'Rechazar roles repetidos', 51500),
+(10, N'Rechazar contraseña en texto plano en lugar de hash', 51500),
+(11, N'Usuario largo no se trunca silenciosamente', 51500),
+(12, N'Nombres largos no se truncan silenciosamente', 51500),
+(13, N'Exigir al menos un rol', 51500),
+(14, N'Exigir empleado nuevo o existente', 51500),
+(15, N'Rechazar ambas opciones de empleado al mismo tiempo', 51500),
+(16, N'Código largo no se trunca silenciosamente', 51500);
+DECLARE @Resultados TABLE (ID int, Caso nvarchar(180), Resultado varchar(4), Detalle nvarchar(4000));
+DECLARE @Caso int = 1, @Esperado int, @NombreCaso nvarchar(180);
+DECLARE @Actor int, @Empleado int, @Disponible int, @Inactivo int;
+DECLARE @Codigo nvarchar(max), @CodigoDisponible varchar(20), @Nombre nvarchar(max);
+DECLARE @Nombres nvarchar(max), @Apellidos nvarchar(max), @Roles nvarchar(max), @Hash nvarchar(max);
+DECLARE @ClaveHash nvarchar(255) = N'$pbkdf2-sha256$600000$HuxZL8PtNPKcYu8utgbkoQ==$NmPYFGhLXt0tyvkysSHHNFjQMIFqSF/tSTU66h3jzik=';
+DECLARE @Sufijo varchar(8), @Actual int, @Detalle nvarchar(4000), @Resultado varchar(4), @Nuevo int;
+
+WHILE @Caso <= 16
+BEGIN
+    SELECT @Esperado = ErrorEsperado, @NombreCaso = Caso FROM @Casos WHERE ID = @Caso;
+    SET @Sufijo = LEFT(REPLACE(CONVERT(varchar(36), NEWID()), '-', ''), 8);
+    SET @Actor = @Admin;
+    SET @Empleado = NULL;
+    SET @Codigo = N'TCUN-' + @Sufijo;
+    SET @CodigoDisponible = 'TCUD-' + @Sufijo;
+    SET @Nombre = N'tc_prueba_' + @Sufijo;
+    SET @Nombres = N'María José'; SET @Apellidos = N'Pérez López';
+    SET @Roles = N'TECNICO,CAJA'; SET @Hash = @ClaveHash;
+    SET @Actual = 0; SET @Detalle = N''; SET @Resultado = 'PASS'; SET @Nuevo = NULL;
+    BEGIN TRY
+        BEGIN TRANSACTION;
+        INSERT INTO dbo.Empleado (Codigo, Nombres, Apellidos, Activo)
+        VALUES (@CodigoDisponible, N'Empleado', N'Disponible', 1);
+        SET @Disponible = CONVERT(int, SCOPE_IDENTITY());
+        INSERT INTO dbo.Empleado (Codigo, Nombres, Apellidos, Activo)
+        VALUES ('TCUI-' + @Sufijo, N'Empleado', N'Inactivo', 0);
+        SET @Inactivo = CONVERT(int, SCOPE_IDENTITY());
+
+        IF @Caso = 2 BEGIN SET @Empleado = @Disponible; SET @Codigo = NULL; SET @Nombres = NULL; SET @Apellidos = NULL; END;
+        IF @Caso = 3 SET @Actor = 0;
+        IF @Caso = 4 SELECT @Nombre = NombreUsuario FROM dbo.Usuario WHERE UsuarioID = @Admin;
+        IF @Caso = 5 SET @Codigo = @CodigoDisponible;
+        IF @Caso = 6 BEGIN SET @Empleado = @Inactivo; SET @Codigo = NULL; SET @Nombres = NULL; SET @Apellidos = NULL; END;
+        IF @Caso = 7 BEGIN
+            SELECT @Empleado = EmpleadoID FROM dbo.Usuario WHERE UsuarioID = @Admin;
+            SET @Codigo = NULL; SET @Nombres = NULL; SET @Apellidos = NULL;
+        END;
+        IF @Caso = 8 SET @Roles = N'ROL_NO_EXISTE';
+        IF @Caso = 9 SET @Roles = N'TECNICO,TECNICO';
+        IF @Caso = 10 SET @Hash = N'TextoPlanoNoPermitido';
+        IF @Caso = 11 SET @Nombre = REPLICATE(N'x', 51);
+        IF @Caso = 12 SET @Nombres = REPLICATE(N'á', 81);
+        IF @Caso = 13 SET @Roles = N'';
+        IF @Caso = 14 BEGIN SET @Codigo = NULL; SET @Nombres = NULL; SET @Apellidos = NULL; END;
+        IF @Caso = 15 SET @Empleado = @Disponible;
+        IF @Caso = 16 SET @Codigo = REPLICATE(N'x', 21);
+
+        EXEC dbo.spRegistrarUsuario @Actor, @Empleado, @Codigo, @Nombres, @Apellidos, @Nombre, @Hash, @Roles;
+        IF @Esperado <> 0 THROW 51991, N'El procedimiento aceptó una entrada que debía rechazar.', 1;
+
+        SELECT @Nuevo = UsuarioID FROM dbo.Usuario WHERE NombreUsuario = @Nombre;
+        IF @Nuevo IS NULL OR NOT EXISTS (
+            SELECT 1 FROM dbo.Usuario WHERE UsuarioID = @Nuevo
+            AND PasswordHash = CONVERT(varchar(255), @ClaveHash) AND AlgoritmoHash = 'PBKDF2_SHA256' AND Activo = 1)
+            THROW 51991, N'La cuenta no conserva el hash y el algoritmo esperados.', 1;
+        IF (SELECT COUNT(*) FROM dbo.UsuarioRol WHERE UsuarioID = @Nuevo) <> 2
+            THROW 51991, N'La cuenta no conserva los dos roles.', 1;
+        IF dbo.fnTieneRol(@Nuevo, 'TECNICO') <> 1 OR dbo.fnTieneRol(@Nuevo, 'ADMIN') <> 0
+            THROW 51991, N'Los permisos no coinciden con los roles asignados.', 1;
+        IF @Caso = 1 AND NOT EXISTS (SELECT 1 FROM dbo.Empleado e INNER JOIN dbo.Usuario u ON u.EmpleadoID = e.EmpleadoID
+                                     WHERE u.UsuarioID = @Nuevo AND e.Nombres = N'María José' AND e.Apellidos = N'Pérez López')
+            THROW 51991, N'Los datos Unicode no se conservaron.', 1;
+        IF @Caso = 2 AND ((SELECT EmpleadoID FROM dbo.Usuario WHERE UsuarioID = @Nuevo) <> @Disponible
+                         OR (SELECT COUNT_BIG(*) FROM dbo.Empleado) <> @EmpleadosIniciales + 2)
+            THROW 51991, N'Se duplicó el empleado existente.', 1;
+        EXEC dbo.spListarUsuarios @Admin, @Nuevo;
+        ROLLBACK TRANSACTION;
+    END TRY
+    BEGIN CATCH
+        SET @Actual = ERROR_NUMBER(); SET @Detalle = ERROR_MESSAGE();
+        IF @@TRANCOUNT > 0 ROLLBACK TRANSACTION;
+        IF @Actual <> @Esperado SET @Resultado = 'FAIL';
+    END CATCH;
+
+    IF (SELECT COUNT_BIG(*) FROM dbo.Usuario) <> @UsuariosIniciales
+       OR (SELECT COUNT_BIG(*) FROM dbo.Empleado) <> @EmpleadosIniciales
+       OR (SELECT COUNT_BIG(*) FROM dbo.UsuarioRol) <> @RolesIniciales
+    BEGIN
+        SET @Resultado = 'FAIL';
+        SET @Detalle = N'Quedaron filas adicionales después de revertir el caso.';
+    END;
+    INSERT INTO @Resultados VALUES (@Caso, @NombreCaso, @Resultado, @Detalle);
+    SET @Caso += 1;
+END;
+SELECT Caso, Resultado, NULLIF(Detalle, N'') AS Detalle FROM @Resultados ORDER BY ID;
+IF EXISTS (SELECT 1 FROM @Resultados WHERE Resultado = 'FAIL')
+    THROW 51992, N'Una o más pruebas no pasaron. Revisá la tabla de resultados.', 1;
+GO
