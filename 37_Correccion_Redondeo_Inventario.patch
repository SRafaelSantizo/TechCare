+    DECLARE @EntradaMicro decimal(18,0)=CONVERT(decimal(18,0),@CostoEntrada*CONVERT(decimal(7,0),1000000));
+    DECLARE @ValorMicro decimal(38,0)=CONVERT(decimal(19,0),@Stock)*@CostoMicro
