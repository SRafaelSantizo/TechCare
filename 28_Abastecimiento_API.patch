+    IF NOT EXISTS (SELECT 1 FROM dbo.Bodega WHERE BodegaID=@BodegaID) THROW 52002,N'La bodega no existe.',1;
+    SELECT * FROM dbo.vBodegaGestion WHERE BodegaID=@BodegaID;
